{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "src/index.ts",
    "src/lib/utils.ts",
    "src/config/designVersion.ts",
    "src/app/components/layout/appShellClasses.ts",
    "src/app/components/layout/slidePanelConstants.ts",
    "src/app/components/ui/floatingPanelSurface.ts"
  ]
}
